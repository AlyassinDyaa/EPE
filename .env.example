# Copy to .env.local for local development, and add the same names in
# Vercel > Project > Settings > Environment Variables for production.

# Password the team uses to sign in to /admin.html (8+ characters).
ADMIN_PASSWORD=change-me-to-something-long

# Random string, 32+ characters, used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Upstash Redis. Added automatically when you connect Upstash in Vercel > Storage.
# Leave empty locally to use a temporary in-memory database.
KV_REST_API_URL=
KV_REST_API_TOKEN=
